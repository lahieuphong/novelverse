---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NovelCard from "@/components/novels/NovelCard.astro";
import LibrarySearch from "@/components/search/LibrarySearch";
import { getNovels, novelStats } from "@/lib/content/catalog";
import { libraryUrl, searchIndexUrl } from "@/lib/urls";

const novels = getNovels();
const number = new Intl.NumberFormat("vi-VN");
const readable = novels.reduce((sum, novel) => sum + novelStats(novel).readable, 0);
---

<BaseLayout title="Thư viện truyện" description={`Thư viện NovelVerse: ${novels.length} truyện chữ tiếng Việt, tìm theo tên hoặc tác giả, có dấu hoặc không dấu.`}>
  <main id="noi-dung" class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6 sm:px-6 sm:py-10">
    <div>
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Thư viện</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        {number.format(novels.length)} truyện · {number.format(readable)} chương đọc được
      </p>
    </div>

    <div class="max-w-xl">
      <LibrarySearch client:idle indexUrl={searchIndexUrl()} actionUrl={libraryUrl()} gridId="library-grid" />
    </div>

    <div id="library-grid" class="grid gap-4 md:grid-cols-2">
      {novels.map((novel, index) => <NovelCard novel={novel} eager={index < 2} headingLevel="h2" />)}
    </div>
  </main>
</BaseLayout>

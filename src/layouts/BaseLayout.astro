---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { headBootstrapScript } from "@/lib/client/settings";
import { assetUrl } from "@/lib/urls";

import { SITE_NAME } from "@/lib/site";

interface Props {
  /** Tiêu đề trang, không gồm tên site. Bỏ trống ở trang chủ. */
  title?: string;
  description: string;
  /** Không index (404). */
  noindex?: boolean;
  /** Liên kết rel=prev/next giữa các chương. */
  prevHref?: string | null;
  nextHref?: string | null;
  ogType?: "website" | "book" | "article";
  bodyClass?: string;
  /** Ẩn footer chung (trang đọc có điều hướng riêng). */
  compactFooter?: boolean;
}

const { title, description, noindex = false, prevHref, nextHref, ogType = "website", bodyClass, compactFooter = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} – Đọc truyện chữ tiếng Việt`;

let pathname = Astro.url.pathname;
if (!pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(pathname)) pathname = `${pathname}/`;
const canonical = Astro.site && !noindex ? new URL(pathname, Astro.site).href : null;
const absolute = (href: string | null | undefined) => (href && Astro.site ? new URL(href, Astro.site).href : href);
---

<!doctype html>
<html lang="vi" class="no-js" data-theme-choice="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141617" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- Sau thẻ theme-color để script cập nhật được màu thanh trình duyệt theo nền đã chọn. -->
    <script is:inline set:html={headBootstrapScript()} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {prevHref && <link rel="prev" href={absolute(prevHref)} />}
    {nextHref && <link rel="next" href={absolute(nextHref)} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={assetUrl("favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={assetUrl("favicon-32x32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={assetUrl("apple-touch-icon.png")} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a
      href="#noi-dung"
      class="sr-only z-50 rounded-md bg-primary px-4 py-3 font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >Bỏ qua tới nội dung chính</a
    >
    <SiteHeader />
    <slot />
    <SiteFooter compact={compactFooter} />
  </body>
</html>

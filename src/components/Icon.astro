---
/**
 * Icon SVG nội tuyến (nét vẽ theo bộ Lucide, giấy phép ISC). Không tải thư viện icon ở client.
 * Mặc định aria-hidden: nút chứa icon phải có nhãn chữ hoặc aria-label.
 */
import { ICON_PATHS, type IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: className = "size-5", size = 24, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICON_PATHS[name]}
/>

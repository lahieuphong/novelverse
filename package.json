{
  "name": "novelverse",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "NovelVerse – website đọc truyện tiếng Việt, dựng tĩnh từ thư mục truyện trong repo",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "content:check": "node scripts/check-content.ts",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "build": "astro build",
    "preview": "astro preview",
    "build:fixture": "node scripts/build-fixture.ts build",
    "preview:fixture": "node scripts/serve-static.ts dist-fixture 4323",
    "serve": "node scripts/serve-static.ts dist 4322",
    "test:e2e": "playwright test",
    "verify": "npm run content:check && npm run typecheck && npm run test && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
